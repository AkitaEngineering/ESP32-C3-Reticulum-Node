{
  "info": {
    "name": "ESP32 Reticulum Gateway API",
    "_postman_id": "reticulum-gateway",
    "description": "Minimal Postman collection for the device REST API (derived from docs/openapi.yaml).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Routes",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" } ],
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/routes", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","routes"] }
      }
    },
    {
      "name": "Get Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/status", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","status"] }
      }
    },
    {
      "name": "Get Config",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" } ],
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/config", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","config"] }
      }
    },
    {
      "name": "Post Config",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"node_name\": \"{{node_name}}\",\n  \"rns_app_name\": \"esp32.node\",\n  \"wifi\": { \"ssid\": \"{{wifi_ssid}}\", \"password\": \"{{wifi_password}}\" },\n  \"api\": { \"auth_enabled\": true, \"token\": \"{{token}}\", \"public_key\": \"{{public_key}}\" }\n}" },
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/config", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","config"] }
      }
    },
    {
      "name": "Save Config",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
          { "key": "Content-Length", "value": "0", "type": "text" }
        ],
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/config/save", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","config","save"] }
      }
    },
    {
      "name": "OTA Upload (signed)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
          { "key": "X-Signature-Ed25519", "value": "{{signature}}", "type": "text" },
          { "key": "X-Firmware-Version", "value": "{{firmware_version}}", "type": "text" },
          { "key": "Content-Type", "value": "application/octet-stream", "type": "text" }
        ],
        "body": { "mode": "file", "file": "{{firmware_file}}" },
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/ota", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","ota"] }
      }
    },
    {
      "name": "Get Metrics",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" } ],
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/metrics", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","metrics"] }
      }
    },
    {
      "name": "Restart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
          { "key": "Content-Length", "value": "0", "type": "text" }
        ],
        "url": { "raw": "http://{{host}}:{{port}}/api/v1/restart", "host": ["{{host}}"], "port": "{{port}}", "path": ["api","v1","restart"] }
      }
    }
  ],
  "variable": [
    { "key": "host", "value": "<device-ip>" },
    { "key": "port", "value": "80" },
    { "key": "token", "value": "" },
    { "key": "node_name", "value": "field-node-001" },
    { "key": "wifi_ssid", "value": "field-net" },
    { "key": "wifi_password", "value": "replace-with-valid-password" },
    { "key": "public_key", "value": "" },
    { "key": "signature", "value": "" },
    { "key": "firmware_version", "value": "0.3.1" },
    { "key": "firmware_file", "value": "firmware.bin" }
  ]
}
