{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "../Reticulum"
		}
	],
	"settings": {
		"files.exclude": {
			"**/.pio": true,
			"**/.venv": true,
			"**/build": true,
			"**/build-*": true,
			"**/cmake-build-*": true,
			"**/tmp_capture": true
		},
		"search.exclude": {
			"**/.pio/**": true,
			"**/.venv/**": true,
			"**/build/**": true,
			"**/build-*/**": true,
			"**/cmake-build-*/**": true,
			"**/tmp_capture/**": true
		},
		"files.watcherExclude": {
			"**/.pio/**": true,
			"**/.venv/**": true,
			"**/build/**": true,
			"**/build-*/**": true,
			"**/cmake-build-*/**": true,
			"**/tmp_capture/**": true
		},
		"C_Cpp.default.browse.path": [
			"${workspaceFolder}/include",
			"${workspaceFolder}/src",
			"${workspaceFolder}/test"
		],
		"C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
		"idf.customExtraVars": {
			"IDF_TARGET": "esp32c3",
			"GIT_DISCOVERY_ACROSS_FILESYSTEM": "1"
		}
	}
}
